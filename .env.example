# Подключение к Postgres (поднимается через docker-compose.yml).
DATABASE_URL=postgresql://poydem:poydem@localhost:5433/poydem

# ОДИН ключ OpenRouter — на текст И картинку. Ключ: openrouter.ai → Keys.
OPENROUTER_API_KEY=

# ТЕКСТ — бесплатная модель (openrouter.ai/models, фильтр Free).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# КАРТИНКА — бесплатная модель из вкладки Image (значок 🎁).
OPENROUTER_IMAGE_MODEL=sourceful/riverflow-v2.5-fast:free
