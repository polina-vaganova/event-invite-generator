# Подключение к Postgres (поднимается через docker-compose.yml).
DATABASE_URL=postgresql://poydem:poydem@localhost:5433/poydem

# ОДИН ключ ИИ-API — на текст И картинку (OpenAI-совместимый провайдер).
OPENROUTER_API_KEY=

# ТЕКСТ — slug модели LLM у выбранного провайдера.
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# КАРТИНКА — slug модели генерации изображений.
OPENROUTER_IMAGE_MODEL=sourceful/riverflow-v2.5-fast:free
