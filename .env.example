# Подключение к Postgres (поднимается через docker-compose.yml).
DATABASE_URL=postgresql://poydem:poydem@localhost:5433/poydem

# OpenRouter — генерация ТЕКСТА открытки (бесплатные LLM).
# Как получить: openrouter.ai → Keys → Create Key.
# Модель (опционально) — бесплатные ищи на openrouter.ai/models (фильтр Free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Cloudflare Workers AI — генерация КАРТИНКИ открытки (FLUX). Решим позже.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
