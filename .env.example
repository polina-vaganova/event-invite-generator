# Подключение к Postgres (поднимается через docker-compose.yml).
DATABASE_URL=postgresql://poydem:poydem@localhost:5433/poydem

# Один ключ OpenRouter — на текст И картинку.
# Как получить: openrouter.ai → Keys → Create Key.
OPENROUTER_API_KEY=

# Модель для ТЕКСТА (бесплатные — openrouter.ai/models, фильтр Free).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Модель для КАРТИНКИ (вкладка Image; выбери бесплатную 🎁 и впиши slug).
OPENROUTER_IMAGE_MODEL=x-ai/grok-imagine-image-quality
