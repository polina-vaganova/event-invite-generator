# Подключение к Postgres (поднимается через docker-compose.yml).
DATABASE_URL=postgresql://poydem:poydem@localhost:5433/poydem

# Cloudflare Workers AI — генерация картинки открытки (FLUX).
# Как получить: dash.cloudflare.com → API Tokens (шаблон «Workers AI») + Account ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Ключ для ИИ-генерации текста (этап текста) — позже.
# GEMINI_API_KEY=
