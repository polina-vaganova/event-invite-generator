# Подключение к Postgres (поднимается через docker-compose.yml).
# Значения совпадают с docker-compose.yml — для локального запуска менять не нужно.
DATABASE_URL=postgresql://poydem:poydem@localhost:5433/poydem

# Ключи для ИИ-генерации текста (этап ИИ) — раскомментируйте нужный.
# GIGACHAT_API_KEY=
# OPENAI_API_KEY=
